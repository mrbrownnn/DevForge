__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.devforge/
scratch/
.claude/

# Credentials must never reach a commit; the ignore rule has to exist
# before the mistake does. DevForge's own policy also denies reading these.
.env
.env.*
*.pem
*.key
id_rsa*
secrets/

# Evaluation output. Reports are build artefacts: machine-specific (latency
# depends on the machine) and regenerated on every run. Commit one deliberately
# when it is the baseline an investigation refers to.
reports/*.json
reports/workspaces/
